<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>FNA.Steamworks</AssemblyName>
    <RootNamespace>Microsoft.Xna.Framework.Net</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x86;x64;AnyCPU</Platforms>
    <PlatformTarget Condition="'$(Platform)' == 'x86'">x86</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' == 'x64'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' == 'AnyCPU'">AnyCPU</PlatformTarget>
    <OutputPath>bin\net9\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\net9\$(Platform)\$(Configuration)\</IntermediateOutputPath>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FNA\FNA.Core.csproj" />
    <ProjectReference Include="Steamworks.NET\Standalone\Steamworks.NET.net9.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <_SteamApiDll Condition="'$(PlatformTarget)' == 'x86' or '$(RuntimeIdentifier)' == 'win-x86'">steam_api.dll</_SteamApiDll>
    <_SteamApiDll Condition="'$(_SteamApiDll)' == ''">steam_api64.dll</_SteamApiDll>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Steamworks.NET/com.rlabrecque.steamworks.net/Plugins/$(_SteamApiDll)"
          Link="$(_SteamApiDll)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" Exclude="src\**\obj\**\*" />
  </ItemGroup>
</Project>
